{
  "simulation_name": "watchdog_slow_task",
  "duration_seconds": 30,
  "scheduler_mode": "round_robin",
  "faults": {
    "enabled": true,
    "type": "slow_task",
    "target_task": "ControlTask",
    "start_after_ms": 5000,
    "extra_execution_time_ms": 120
  },
  "watchdog": {
    "enabled": true,
    "check_interval_ms": 100,
    "max_consecutive_deadline_misses": 3,
    "recovery_enabled": true,
    "recovery_cooldown_ms": 1000
  },
  "tasks": [
    {
      "name": "ControlTask",
      "period_ms": 100,
      "deadline_ms": 80,
      "priority": 1,
      "execution_time_ms": 10,
      "queue_limit": 10
    },
    {
      "name": "NetworkTask",
      "period_ms": 250,
      "deadline_ms": 200,
      "priority": 2,
      "execution_time_ms": 20,
      "queue_limit": 10
    },
    {
      "name": "LoggerTask",
      "period_ms": 500,
      "deadline_ms": 400,
      "priority": 3,
      "execution_time_ms": 15,
      "queue_limit": 20
    }
  ]
}
